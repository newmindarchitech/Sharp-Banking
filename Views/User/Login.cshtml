@model BankingVault.Models.LoginForm

@{
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Banking Vault</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --banking-primary: #0A4D3C;
            --banking-primary-light: #0E6B4F;
        }

        body {
            font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--banking-primary) 0%, var(--banking-primary-light) 100%);
            padding: 2rem;
        }

        .auth-card {
            background: white;
            padding: 3rem;
            border-radius: 12px;
            box-shadow: 0 20px 25px rgba(0,0,0,0.15);
            max-width: 450px;
            width: 100%;
            animation: fadeInUp 0.6s ease;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .auth-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: #1A1A1A;
        }

        .auth-subtitle {
            color: #6B7280;
            font-size: 1rem;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #374151;
        }

        .form-control {
            padding: 0.875rem 1rem;
            border: 2px solid #E5E7EB;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--banking-primary);
            box-shadow: 0 0 0 3px rgba(10, 77, 60, 0.1);
        }

        .btn-primary {
            background: var(--banking-primary);
            border-color: var(--banking-primary);
            padding: 0.875rem 1.5rem;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: #073529;
            border-color: #073529;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .auth-footer {
            text-align: center;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid #E5E7EB;
        }

        .auth-footer a {
            color: var(--banking-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .text-danger {
            color: #EF4444;
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }

        .alert-danger {
            background: #FEE2E2;
            border: 2px solid #EF4444;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            color: #991B1B;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 576px) {
            .auth-card {
                padding: 2rem;
            }
            .auth-title {
                font-size: 1.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">💰</div>
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Đăng nhập vào Banking Vault</p>
            @if (!ViewData.ModelState.IsValid)
            {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                <div>@error.ErrorMessage</div>
                    }
            </div>
            }

            <form method="post" asp-controller="User" asp-action="Login">
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email Address</label>
                    <input class="form-control" asp-for="Email" type="email" placeholder="your.email@example.com" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input class="form-control" asp-for="Password" type="password" placeholder="••••••••" />
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Login to Account</button>
            </form>
            <div class="auth-footer">
                <span class="text-muted">Chưa có tài khoản? </span>
                <a asp-controller="User" asp-action="Register">Đăng ký ngay</a>
        </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
